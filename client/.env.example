# Copy to .env.local for development, or set in the Vercel dashboard for production.

# Where the Spring Boot API lives, including the /api prefix.
# Local:      http://localhost:8080/api
# Production: https://your-service.onrender.com/api
#
# The "Continue with Google" link is derived from this by dropping /api, so the
# value must point at the same host that serves /oauth2/authorization/google.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
